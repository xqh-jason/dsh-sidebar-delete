{
  "name": "dsh-sidebar-delete",
  "version": "0.1.7",
  "description": "Delete sessions — local logs included, irreversibly — and manage or delete workspaces from the DeepSeek Harness (dsh) sidebar. · 在 dsh 侧栏删除会话（连带本地日志，不可恢复），并管理工作区。",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "author": "xqh-jason",
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check src/session-store.mjs && node --check src/http-fence.mjs && node --check src/delete-session.mjs && node --check src/auto-purge.mjs && node --check src/purge-state.mjs",
    "test": "node --test test/*.test.mjs",
    "pack:check": "npm pack --dry-run",
    "verify": "npm run check && npm test && npm run pack:check",
    "prepublishOnly": "npm run verify"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "sidebar",
    "session",
    "workspace",
    "delete",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xqh-jason/dsh-sidebar-delete.git"
  },
  "homepage": "https://github.com/xqh-jason/dsh-sidebar-delete#readme",
  "bugs": {
    "url": "https://github.com/xqh-jason/dsh-sidebar-delete/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
